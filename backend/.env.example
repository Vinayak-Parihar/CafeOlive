# Cafe Olive — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit the real .env file.

# ── App ──────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=3000
# Current environment. Controls things like mock-payment fallbacks — always "production" in prod.
NODE_ENV=development
# Allowed CORS origin(s) for the frontend. Use "*" only for local development.
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string (e.g. a MongoDB Atlas SRV URI, including credentials).
MONGODB_URL=mongodb+srv://your_db_user:your_db_password@your-cluster.mongodb.net/your_db_name

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Secret used to sign short-lived access tokens. Use a long, random string.
ACCESS_TOKEN_SECRET=your_access_token_secret
# How long an access token stays valid (e.g. 1d, 15m).
ACCESS_TOKEN_EXPIRY=1d
# Secret used to sign long-lived refresh tokens. Use a different long, random string.
REFRESH_TOKEN_SECRET=your_refresh_token_secret
# How long a refresh token stays valid (e.g. 10d).
REFRESH_TOKEN_EXPIRY=10d

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
# Your Cloudinary account's cloud name.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# Your Cloudinary API key.
CLOUDINARY_API_KEY=your_cloudinary_api_key
# Your Cloudinary API secret.
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Razorpay (payments) ──────────────────────────────────────────────────────
# Razorpay key ID (test or live, from the Razorpay dashboard).
RAZORPAY_KEY_ID=your_razorpay_key_id
# Razorpay key secret. If left unset, payment signature verification falls back to a
# local mock mode (never happens when NODE_ENV/keys are configured correctly for production).
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Email (reservation confirmations via SMTP) ───────────────────────────────
# Any SMTP provider works (Gmail, Zoho, SES, etc.). Leave these unset to skip sending
# (a warning is logged instead of failing the request).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=your_smtp_from_address

# ── WhatsApp (reservation confirmations via Twilio) ──────────────────────────
# From https://console.twilio.com. Leave these unset to skip sending WhatsApp messages.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio WhatsApp sandbox "from" number works out of the box for testing.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Admin seed script (src/seedAdmin.js) ─────────────────────────────────────
# Identity used when seeding the first super-admin account. Change the password
# immediately after first login.
SEED_ADMIN_FULLNAME=Super Admin
SEED_ADMIN_USERNAME=super_admin
SEED_ADMIN_EMAIL=your_admin_email@example.com
SEED_ADMIN_PASSWORD=change_this_password
SEED_ADMIN_PHONE=0000000000

# ── RBAC verification script (src/verify_rbac.js) ────────────────────────────
# Password used only for the throwaway test accounts this script creates and deletes.
RBAC_TEST_PASSWORD=your_rbac_test_password

# ── Local debug scripts (src/debugMenu.js, debugCategory.js, testAdmin.js) ───
# Base URL the debug scripts hit — point this at your running backend instance.
API_BASE_URL=http://localhost:3000
# Admin credentials the debug scripts log in with (must match a real account on that instance).
DEBUG_ADMIN_USERNAME=your_debug_admin_username
DEBUG_ADMIN_PASSWORD=your_debug_admin_password
